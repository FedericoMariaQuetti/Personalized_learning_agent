# ------------------------------------------------------------------
# COPIA questo file in ".env" SOLO se vuoi testare in locale sul tuo PC.
# Su GitHub, queste variabili vanno inserite come "Secrets" del repo
# (Settings -> Secrets and variables -> Actions), MAI scritte nel codice.
# ------------------------------------------------------------------

# --- Provider AI per i riassunti ---
LLM_PROVIDER=gemini          # "gemini" oppure "ollama"

# Necessario solo se LLM_PROVIDER=gemini
GEMINI_API_KEY=incolla_qui_la_tua_chiave_gratuita

# Necessario solo se LLM_PROVIDER=ollama (funziona solo in locale, non su GitHub Actions)
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# --- Invio email (Gmail) ---
GMAIL_USER=tuo.indirizzo@gmail.com
GMAIL_APP_PASSWORD=password_per_le_app_generata_da_google
RECIPIENT_EMAIL=destinatario1@example.com,destinatario2@example.com
